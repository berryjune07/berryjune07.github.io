# gem "jekyll", "~> 3.9"

group :jekyll_plugins do
  gem 'github-pages'
  gem 'jekyll-include-cache'
  gem 'jekyll-compose'
  gem 'jekyll-spaceship'
  gem 'jekyll-paginate'
end

